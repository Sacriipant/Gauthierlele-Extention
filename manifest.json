{
  "manifest_version": 3,
  "name": "Gauthierlele Stream Companion",
  "version": "2.0.0",
  "description": "Official companion extension for Gauthierlele's Twitch stream.",
  "permissions": ["tabs", "notifications", "storage", "scripting", "alarms", "activeTab"],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://gql.twitch.tv/*",
    "https://api.faceit.com/*",
    "https://open.faceit.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/badge_f20.png",
        "icons/badge_f20@2x.png",
        "icons/icon_shake1.png",
        "icons/icon_shake2.png",
        "icons/icon_shake3.png",
        "icons/icon_shake4.png"
      ],
      "matches": ["https://www.twitch.tv/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gauthierlele Stream Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
